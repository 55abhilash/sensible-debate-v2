# Copy this file to .env and adjust as needed.
# Every value is optional - sensible defaults live in app/config.py.

# How long each person gets to write an argument, in seconds.
SD_ARGUMENT_SECONDS=300

# How long the mandatory "read and reflect" pause lasts, in seconds.
SD_REFLECTION_SECONDS=120

# 0 = a debate can run indefinitely (either side can click Leave to end it).
# Set to e.g. 6 to automatically end a debate after 6 rounds each.
SD_MAX_ROUNDS=0

# A topic nobody has joined is auto-closed after this many minutes.
SD_TOPIC_EXPIRY_MINUTES=60

# SQLite is fine for a single small server. For a multi-instance AWS
# deployment (see DEPLOYMENT_AWS.md) this needs to be a shared Postgres
# database instead - note the +psycopg in the scheme, since that's the
# driver this project uses (installed via requirements.txt):
# postgresql+psycopg://user:pass@host:5432/sensible_debate
SD_DATABASE_URL=sqlite:///./data/sensible_debate.db

# Required - this is where live debate coordination happens (see
# app/realtime.py). A local Redis on the default port is fine for
# development; DEPLOYMENT_AWS.md points this at ElastiCache instead.
SD_REDIS_URL=redis://127.0.0.1:6379/0

SD_HOST=0.0.0.0
SD_PORT=8000
